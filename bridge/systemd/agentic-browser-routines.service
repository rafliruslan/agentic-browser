[Unit]
Description=Run any scheduled routines that are due
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/agentic-browser/bridge
ExecStart=/usr/bin/env node %h/.local/share/agentic-browser/bridge/routines.mjs
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=1800
