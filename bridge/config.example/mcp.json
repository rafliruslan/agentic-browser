{
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ]
    },
    "devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "browser-repl": {
      "command": "node",
      "args": [
        "/home/USERNAME/.local/share/agentic-browser/plugin/repl/server.mjs"
      ]
    },
    "memory": {
      "command": "node",
      "args": [
        "/home/USERNAME/.local/share/agentic-browser/plugin/memory/server.mjs"
      ]
    },
    "slack": {
      "command": "node",
      "args": [
        "/home/USERNAME/.local/share/agentic-browser/bridge/slack-mcp.mjs"
      ]
    }
  }
}
