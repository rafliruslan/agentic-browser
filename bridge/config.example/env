# Copy to ~/.config/agentic-browser/env and chmod 600. Never commit the filled copy.
#
# ALLOWED_USER is the operator. With TEAM_USERS unset it is the entire security
# boundary. There is no channel allowlist by default: exactly one person may
# issue commands, anywhere the bot has been invited, because a channel the bot
# is not in cannot deliver a mention at all.

# Bot User OAuth Token, from OAuth & Permissions. Starts xoxb-
SLACK_BOT_TOKEN=

# App-Level Token with connections:write, from Basic Information. Starts xapp-
SLACK_APP_TOKEN=

# Your Slack member ID (profile, More, Copy member ID). Starts U
ALLOWED_USER=

# Optional. Leave unset or "*" for any channel the bot is in; set one channel id
# to additionally pin it there.
ALLOWED_CHANNEL=*

# Optional. How many agent runs may be in flight at once across threads.
# Concurrent runs open their own tabs and do not interfere; the cap is about
# memory and rate limits, not correctness.
MAX_CONCURRENT=3

# Optional. Teammates: a second, narrower tier (no shell, no credentials, no
# operator-only pages). Member ids, comma-separated. Unset means operator only.
TEAM_USERS=

# Where teammates are served, comma-separated channel ids. "*" is every channel
# the bot is in, "!C..." leaves one out. A DM or group DM never counts under "*".
# Nothing listed means no teammate is served anywhere.
TEAM_CHANNELS=

# Optional. Teammates in the operations team (Slack user ids, comma-separated).
# They reach the path fence's `opsAllow` paths, which teamDeny keeps from the rest.
# In a WhatsApp config, mark a person "ops": true instead.
OPS_USERS=

# Optional. The path fence JSON the agent's file tools use. Set it and Slack
# `upload` and WhatsApp attachments obey it too: a teammate is not sent what
# their turn may not Read. Unset, teammates are sent no files at all.
UPLOAD_FENCE=

# Optional. A .zip fetched with the `file` tool is unpacked under the strict
# profile: lower size caps, and no programs, scripts, installers or hidden files.
# 0 turns the strict profile off. Say so only for an agent you trust with
# whatever a teammate sends.
UNZIP_SANDBOX=1

# Optional. Absolute path of the browser's sessions folder (Aside:
# /Users/USERNAME/.aside/u/0/sessions). Lets `upload` send a file the browser
# saved to a session's artifacts/ or tmp/ folder, for an agent with no shell to
# copy it out. Never on a teammate's turn. Unset: off.
UPLOAD_BROWSER_SESSIONS=

# Optional. Linear as a second front door; see ../linear-relay/README.md.
# All three, or none. LINEAR_AGENT is hammock or tara, the name the relay knows
# this bridge by. The token is the relay's PULL_TOKEN for that agent.
LINEAR_RELAY_URL=
LINEAR_RELAY_TOKEN=
LINEAR_AGENT=
