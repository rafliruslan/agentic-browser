# Copy to ~/.config/agentic-browser/env and chmod 600. Never commit the filled copy.
#
# ALLOWED_USER is the entire security boundary. There is no channel allowlist by
# default: exactly one person may issue commands, anywhere the bot has been
# invited, because a channel the bot is not in cannot deliver a mention at all.

# Bot User OAuth Token, from OAuth & Permissions. Starts xoxb-
SLACK_BOT_TOKEN=

# App-Level Token with connections:write, from Basic Information. Starts xapp-
SLACK_APP_TOKEN=

# Your Slack member ID (profile, More, Copy member ID). Starts U
ALLOWED_USER=

# Optional. Leave unset or "*" for any channel the bot is in; set one channel id
# to additionally pin it there.
ALLOWED_CHANNEL=*

# Optional. How many agent runs may be in flight at once across threads.
# Concurrent runs open their own tabs and do not interfere; the cap is about
# memory and rate limits, not correctness.
MAX_CONCURRENT=3
