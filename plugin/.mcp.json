{
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ]
    },
    "devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "browser-repl": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/repl/server.mjs"]
    },
    "memory": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/memory/server.mjs"]
    }
  }
}
